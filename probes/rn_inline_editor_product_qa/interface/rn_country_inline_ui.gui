# INACTIVE product candidate. Exact vanilla 1.19.3 politics_tab local coordinates.
# Iteration 3 (after PID42644 "very tight" country editor): closed label/pencil unchanged;
# opened editor is a framed two-row overlay with hoi_18 356px fields (32 x widest glyph by .fnt),
# a status line, Enter (Apply shortcut RETURN, fields ignore_enter) and Esc (Cancel shortcut ESCAPE).
guiTypes = {
	containerWindowType = {
		name = "rn_ip_country_launcher_window"
		position = { x = 45 y = 29 }
		size = { width = 393 height = 14 }
