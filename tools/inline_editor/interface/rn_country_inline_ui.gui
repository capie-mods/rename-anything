# Rename Anything in-place editor. Exact vanilla 1.19.3 politics_tab local coordinates.
# Iteration 3 (after PID42644 "very tight" country editor): closed label/pencil unchanged;
# opened editor is a framed two-row overlay with hoi_18 356px fields (32 x widest glyph by .fnt),
# a status line and Enter (Apply shortcut RETURN, fields ignore_enter). Iteration 4: no ESCAPE shortcut
# (vanilla politics close_button owns Esc and wins; PID49352).
guiTypes = {
	containerWindowType = {
		name = "rn_ip_country_launcher_window"
		# Iteration 4: on the title line of the politics panel. Vanilla has no country-name text
		# here (only political_title 45,8 "Polityka"); the former subtitle at 45,29 was ours.
		# Name right-aligned ending at the pencil, so a longer name grows to the left.
		# Rules icon (rules_sum_icon 34x40) starts at x460, close button at x508.
		position = { x = 150 y = 8 }
		size = { width = 306 height = 22 }
		orientation = upper_left
		clipping = no
		instantTextboxType = {
			name = "rn_ip_country_label"
			position = { x = 0 y = 2 }
			font = "hoi_18mbs"
			text = "[ROOT.GetName]"
			maxWidth = 278
			maxHeight = 20
			fixedsize = yes
			format = right
			alwaystransparent = yes
		}
		buttonType = {
			name = "rn_ip_country_open"
			position = { x = 284 y = 1 }
			scale = 0.67 # 30x30 frame -> 20x20, same size as the leader/party pencils
			quadTextureSprite = "GFX_edit_designer_notes_button"
			buttonFont = "hoi_18mbs"
			clicksound = click_default
			pdx_tooltip = "RN_IPC_EDIT_COUNTRY"
		}
	}
	containerWindowType = {
		name = "rn_ip_country_window"
		# Opened overlay 18..438 x 28..102 temporarily covers the title subtitle row, the top of the
		# portrait (from y58) and the top of the national-focus box.
		position = { x = 18 y = 28 }
		size = { width = 420 height = 74 }
		orientation = upper_left
		clipping = no
		background = { name = "Background" quadTextureSprite = "GFX_generic_bg2" }
		# Resolved carriers in the SAME player/country context as the native fields.
		# Native integration must copy once at opening; these are not editbox bindings.
		instantTextboxType = {
			name = "rn_ip_country_name_prefill"
			position = { x = 0 y = 0 }
			font = "Main_14"
			text = "[ROOT.GetName]"
			maxWidth = 210
			maxHeight = 14
			fixedsize = yes
			alwaystransparent = yes
		}
		instantTextboxType = {
			name = "rn_ip_country_adj_prefill"
			position = { x = 218 y = 0 }
			font = "Main_14"
			text = "[ROOT.GetAdjective]"
			maxWidth = 145
			maxHeight = 14
			fixedsize = yes
			alwaystransparent = yes
		}
		instantTextboxType = {
			name = "rn_ip_country_epoch"
			position = { x = 0 y = 0 }
			font = "Main_14"
			text = "[?ROOT.rn_ip_epoch|0]"
			maxWidth = 210
			maxHeight = 14
			fixedsize = yes
			alwaystransparent = yes
		}
		containerWindowType = {
			name = "rn_ipc_name_frame"
			position = { x = 0 y = 0 }
			size = { width = 364 height = 26 }
			clipping = no
			background = { name = "Background" spriteType = "GFX_tiles_dark_area_cut_8" alwaysTransparent = yes }
		}
		containerWindowType = {
			name = "rn_ipc_adj_frame"
			position = { x = 0 y = 30 }
			size = { width = 364 height = 26 }
			clipping = no
			background = { name = "Background" spriteType = "GFX_tiles_dark_area_cut_8" alwaysTransparent = yes }
		}
		editBoxType = {
			name = "rn_ip_country_name_edit"
			position = { x = 4 y = 3 }
			size = { x = 356 y = 20 }
			font = "hoi_18"
			borderSize = { x = 0 y = 0 }
			text = ""
			ignore_enter = yes
		}
		editBoxType = {
			name = "rn_ip_country_adj_edit"
			position = { x = 4 y = 33 }
			size = { x = 356 y = 20 }
			font = "hoi_18"
			borderSize = { x = 0 y = 0 }
			text = ""
			ignore_enter = yes
		}
		buttonType = {
			name = "rn_ip_country_apply"
			position = { x = 370 y = 3 }
			scale = 0.67 # 20x20
			quadTextureSprite = "GFX_preset_button_save"
			buttonFont = "hoi_18mbs"
			clicksound = click_default
			pdx_tooltip = "RN_IP_APPLY_COUNTRY"
			shortcut = "RETURN"
		}
		buttonType = {
			name = "rn_ip_country_cancel"
			position = { x = 396 y = 5 }
			quadTextureSprite = "GFX_closebutton_16"
			clicksound = click_close
			pdx_tooltip = "RN_IPC_CANCEL"
		}
		instantTextboxType = {
			name = "rn_ip_country_status"
			position = { x = 6 y = 58 }
			font = "Arial12"
			text = "[ROOT.RN_IP_STATUS]"
			maxWidth = 408
			maxHeight = 14
			fixedsize = yes
			alwaystransparent = yes
		}
	}
}
